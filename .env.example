# URL pública del sitio, sin barra final. En local es http://localhost:3000.
# Se usa para metadatos, sitemap, robots y links absolutos (step 22).
# En producción es obligatoria: sin ella el build falla, para no publicar canonical,
# Open Graph ni sitemap apuntando a localhost.
# Qué cuenta como producción: VERCEL_ENV=production, que Vercel setea sola; preview
# y local quedan con noindex y Disallow: / automáticamente (docs/decisiones/0014).
NEXT_PUBLIC_SITE_URL=

# --- Supabase local (step 02) ---
# Estos valores son los del entorno local que levanta `pnpm db:up` (CLI de Supabase en Docker).
# Son públicos y fijos: la CLI los da iguales en todas las máquinas, así que no son secretos y
# pueden ir con valor acá (ver docs/decisiones/0003). Si no coinciden con tu entorno, corré
# `pnpm db:status` y copiá los que muestra.
# En staging y producción estos valores los da el step 26 y se cargan en Vercel, nunca acá.

# Conexión de la app (Prisma Client, src/lib/db.ts). En la nube es el pooler de Supabase
# (Supavisor) en modo transaction, puerto 6543. En local no hay pooler: apunta directo a la base.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Conexión directa, sin pooler: la usa la CLI de Prisma (migraciones, Studio) desde
# prisma.config.ts. En la nube es la conexión directa de Supabase (puerto 5432).
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# URL de la API de Supabase y clave publicable (navegador y servidor).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Clave secreta: solo servidor y scripts (crear administradores). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# --- Anti-spam (step 11) ---
# Claves OFICIALES DE PRUEBA: pasan siempre. Solo desarrollo y tests.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Para producción: crear widget Managed en la cuenta del cliente, restringir dominios
# y reemplazar AMBAS claves por las reales. Nunca exponer la secret key al cliente.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Generar una sal privada aleatoria (ej.: openssl rand -hex 32), estable por entorno.
# No dejar vacía; cambiarla reinicia los buckets por IP existentes.
IP_HASH_SALT=
# Alternativa opcional si falla el captcha: número real confirmado, solo dígitos.
# No usar los datos provisorios de BUSINESS_DETAILS. Sin número no se inventa un link.
WHATSAPP_NUMBER=5493794057190

# Step 21: dejar vacío hasta configurar GTM/GA4 y acordar cookies con el cliente.
NEXT_PUBLIC_GTM_ID=
